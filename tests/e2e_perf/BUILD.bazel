"""
End-to-end performance tests: mw::com sender -> gatewayd/someipd -> SOME/IP -> someipd/gatewayd
-> mw::com receiver, with both nodes running on the same host.
"""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

exports_files(
    ["nodes.py"],
    visibility = ["//tests/benchmarks:__pkg__"],
)

# Used as --run_under by --config=perf-tests, see .bazelrc.
sh_binary(
    name = "setup_network",
    srcs = ["setup_network.sh"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)
