load("//quality/integration_testing:integration_testing.bzl", "integration_test")

_ITF_ARGS = [
    "--color=yes",
    "-p",
    "tc8_itf_conftest",
    "-p",
    "attribute_plugin",
]

_ITF_DEPS = [
    "//tests/tc8_conformance:tc8-itf-lib",
    "//tests/common:capture",
    "@score_tooling//python_basics/score_pytest:attribute_plugin",
]

integration_test(
    name = "test_tc8_service_discovery",
    timeout = "long",
    srcs = [
        "//tests/tc8_conformance:test_service_discovery.py",
