cc_library(
    name = "service_instance_test_fixture",
    testonly = True,
    hdrs = ["service_instance_test_fixture.h"],
    features = COMPILER_WARNING_FEATURES,
    deps = [
        "//score/config:config_flatbuffers",
        "//score/gateway_ipc_binding/test/unit:mw_com_mocks",
        "//score/serializer",
        "//score/socom:mock",
        "@googletest//:gtest",
        "@score_communication//score/mw/com",
    ],
)

