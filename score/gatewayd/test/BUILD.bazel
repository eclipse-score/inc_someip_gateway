# Provides a local service, so that gatewayd bridges it and someipd offers it on SOME/IP.
cc_binary(
    name = "local_service_provider",
    testonly = True,
    srcs = ["local_service_provider.cpp"],
    features = COMPILER_WARNING_FEATURES,
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//score/serializer:pre_serialized_data",
        "@score_baselibs//score/filesystem",
        "@score_communication//score/mw/com",
    ],
)

score_py_pytest(
    name = "gatewayd_test",
    srcs = [
        "conftest.py",
        "gatewayd_test.py",
    ],
    args = [
        "--configuration=$(location //score/config:config_file)",
        "--gatewayd=$(location //score/gatewayd:gatewayd)",
        "--local-service-provider=$(location :local_service_provider)",
        "--service-instance-manifest=$(location //score/gatewayd:etc/mw_com_config.json)",
        "--someipd=$(location //score/someipd:someipd)",
        "--someipd-service-instance-manifest=$(location //score/someipd:etc/mw_com_config.json)",
    ],
    data = [
        ":local_service_provider",
        "//score/config:config_file",
        "//score/gatewayd",
        "//score/gatewayd:etc/mw_com_config.json",
        "//score/serializer:null_serializer",
        "//score/someipd",
        "//score/someipd:etc/mw_com_config.json",
    ],
    tags = [
        "block-network",
        "unit",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//:__pkg__"],
    deps = [
        "//quality/pytest:process",
    ],
)
