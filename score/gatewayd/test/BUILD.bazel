py_test(
    name = "gatewayd_test",
    srcs = ["gatewayd_test.py"],
    args = [
        "$(location //score/gatewayd:gatewayd)",
        "$(location //score/someipd:someipd)",
        "$(location //score/config:config_file)",
        "$(location //score/gatewayd:etc/mw_com_config.json)",
        "$(location //score/someipd:etc/mw_com_config.json)",
    ],
    data = [
        "//score/config:config_file",
        "//score/gatewayd",
        "//score/gatewayd:etc/mw_com_config.json",
        "//score/serializer:null_serializer",
        "//score/someipd",
        "//score/someipd:etc/mw_com_config.json",
    ],
    tags = [
        "block-network",
        "unit",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//:__pkg__"],
    deps = [
        "//quality/pytest:process",
    ],
)
