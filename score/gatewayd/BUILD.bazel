"""
This daemon is a gateway between the SCORE middleware and the SOME/IP communication stack.
"""

load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@score_docs_as_code//:docs.bzl", "docs_bundle")
load("//bazel/tools:json_schema_validator.bzl", "validate_json_schema_test")

exports_files(
    [
        "etc/mw_com_config.json",
    ],
)

cc_binary(
    name = "gatewayd",
    srcs = ["main.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        ":local_service_instance",
        ":remote_service_instance",
        "//score/bridged_services",
        "//score/config:config_flatbuffers",
        "//score/gateway_ipc_binding:gateway_ipc_binding_mw_com",
        "//score/serializer",
        "//score/socom",
        "@score_baselibs//score/filesystem",
        "@score_baselibs//score/mw/log",
        "@score_communication//score/mw/com",
    ],
)

cc_library(
    name = "local_service_instance",
    srcs = ["impl/local_service_instance.cpp"],
    hdrs = ["impl/local_service_instance.h"],
    deps = [
        "//score/config:config_flatbuffers",
        "//score/serializer",
        "//score/socom",
        "//score/someip",
        "@score_baselibs//score/mw/log",
        "@score_communication//score/mw/com",
    ],
)

cc_library(
    name = "remote_service_instance",
    srcs = ["impl/remote_service_instance.cpp"],
    hdrs = ["impl/remote_service_instance.h"],
    deps = [
        "//score/config:config_flatbuffers",
        "//score/serializer",
        "//score/socom",
        "//score/someip",
        "@score_baselibs//score/containers:non_relocatable_vector",
        "@score_baselibs//score/mw/log",
        "@score_communication//score/mw/com",
    ],
)

validate_json_schema_test(
    name = "mw_com_config_schema_valid",
    size = "small",
    json = "etc/mw_com_config.json",
    schema = "@score_communication//score/mw/com:config_schema",
    tags = ["lint"],
)

native_binary(
    name = "gatewayd_example",
    src = "//score/gatewayd",
    args = [
        "--configuration",
        "$(rootpath //score/config:config_file)",
        "--service_instance_manifest",
        "$(rootpath etc/mw_com_config.json)",
    ],
    data = [
        "etc/mw_com_config.json",
        "//score/config:config_file",
        "//score/serializer:null_serializer",
    ],
)

# Keep the bundle at the component package boundary so coverage includes local
# implementation dependencies while excluding code owned by other components.
docs_bundle(
    name = "docs_bundle",
    code_targets = [
        ":gatewayd",
    ],
    primary_need_id = "comp__gatewayd",
    source_dir = "docs",
    visibility = ["//visibility:public"],
)
