@startuml
hide empty description

state "Service_state::not_available" as Not_available
state "Service_state::available" as Available {
    state "Event_state::unsubscribed" as unsubscribed
    state "Event_state::subscribed" as subscribed

    [*] --> unsubscribed
    unsubscribed --> subscribed : Client_connector::subscribe_event()
    subscribed --> unsubscribed : Client_connector::unsubscribe_event()
}

[*] --> Not_available
Not_available --> Available : Client_connector::Callbacks::\non_service_state_change\n(Service_state::available)
Available --> Not_available : Client_connector::Callbacks::\non_service_state_change\n(Service_state::not_available)

@enduml
