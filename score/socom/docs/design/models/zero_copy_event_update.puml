@startuml Zero Copy Event Update from Network

actor network as "Network"

box "someipd (Network Daemon, QM)"
participant someip_network_impl as "SOME/IP Network Stack"
participant socom_server_nd as "socom::Enabled_server_connector"
participant socom_client_nd as "socom::Client_connector"
participant ipc_provider as "gateway_ipc_binding::\nProvider_service_binding"
end box

participant lola_shm as "mw::com (LoLa Shared Memory)\nGenericSkeleton / GenericProxy"

box "gatewayd (Gateway Daemon, ASIL_B)"
participant ipc_consumer as "gateway_ipc_binding::\nConsumer_service_binding"
participant socom_server_gd as "socom::Enabled_server_connector"
participant socom_client_gd as "socom::Client_connector"
participant gateway as "Gateway Logic\n(E2E & Forwarding)"
participant app_mwcom as "Application mw::com"
end box

note right of network
For zero-copy event transport, each bridged event sample in LoLa shared memory
stores an 8-byte length prefix followed contiguously by the full SOME/IP message
(16-byte SOME/IP header + payload). Writable_payload::wdata() and Payload::data()
reference this contiguous full SOME/IP message span.
end note

== Allocate LoLa shared-memory slot and read full SOME/IP message from network ==

network -> someip_network_impl : Receive event update notification
activate someip_network_impl

someip_network_impl -> socom_server_nd : allocate_event_payload(event_id)
activate socom_server_nd
socom_server_nd -> socom_client_nd : on_event_payload_allocate(event_id)
activate socom_client_nd
socom_client_nd -> ipc_provider : on_event_payload_allocate(event_id)
activate ipc_provider
ipc_provider -> lola_shm : GenericSkeletonEvent::Allocate()
activate lola_shm
return SampleAllocateePtr
return Writable_payload(wdata, slot_handle)
return Writable_payload(wdata, slot_handle)
return Writable_payload(wdata, slot_handle)

someip_network_impl -> network : Read full SOME/IP message (header + payload)\ninto Writable_payload::wdata() and shrink(size)

== Publish event update via gateway_ipc_binding over LoLa shared memory ==

someip_network_impl -> socom_server_nd : update_event(event_id, Payload)
activate socom_server_nd
socom_server_nd -> socom_client_nd : on_event_update(event_id, Payload)
activate socom_client_nd
socom_client_nd -> ipc_provider : on_event_update(event_id, Payload)
activate ipc_provider
ipc_provider -> ipc_provider : Lookup SampleAllocateePtr by payload.get_slot_handle()\nand write payload.data().size() into sample prefix
ipc_provider -> lola_shm : GenericSkeletonEvent::Send(sample)
activate lola_shm
return
return
return
return
deactivate someip_network_impl

== Receive event in gatewayd, verify E2E over contiguous Payload::data(), and forward ==

lola_shm ->> ipc_consumer : Receive handler notification
activate ipc_consumer
ipc_consumer -> lola_shm : GenericProxyEvent::GetNewSamples()
activate lola_shm
return SamplePtr (contiguous SOME/IP header + payload)

ipc_consumer -> socom_server_gd : update_event(event_id, Payload(data, slot_handle, release_cb))
activate socom_server_gd
socom_server_gd -> socom_client_gd : on_event_update(event_id, Payload)
activate socom_client_gd
socom_client_gd -> gateway : on_event_update(event_id, Payload)
activate gateway
gateway -> gateway : E2E check over contiguous full SOME/IP message\nin Payload::data() (header + payload)
gateway -> app_mwcom : Allocate, serialize/copy payload, and Send(event_id)
activate app_mwcom
return
return
return
return
note right of ipc_consumer
Destroying Payload invokes release_cb,
dropping SamplePtr and returning the LoLa slot.
end note
deactivate ipc_consumer

@enduml
