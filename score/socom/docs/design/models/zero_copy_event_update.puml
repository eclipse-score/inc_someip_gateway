@startuml Zero Copy Event Update from Network
title Zero-copy event update across someipd and gatewayd

actor "Network" as network
box "someipd process"
participant "SOME/IP Stack" as someip_stack
participant "socom::Enabled_server_connector" as socom_srv_nd
participant "socom::Client_connector" as socom_cli_nd
participant "Provider_service_binding" as ipc_provider
end box
participant "mw::com\n(LoLa SHM)" as lola_shm
box "gatewayd process"
participant "Consumer_service_binding" as ipc_consumer
participant "socom::Enabled_server_connector" as socom_srv_gd
participant "socom::Client_connector" as socom_cli_gd
participant "RemoteServiceInstance" as remote_svc
end box
participant "mw::com\n(Application)" as app_mwcom

== Allocate shared-memory slot and write SOME/IP frame ==
network -> someip_stack : event notification
someip_stack -> socom_srv_nd : allocate_event_payload(event)
socom_srv_nd -> socom_cli_nd : on_event_payload_allocate(event)
socom_cli_nd -> ipc_provider : on_event_payload_allocate(event)
ipc_provider -> lola_shm : Allocate()
lola_shm --> ipc_provider : SampleAllocateePtr
ipc_provider --> socom_cli_nd : Writable_payload
socom_cli_nd --> socom_srv_nd : Writable_payload
socom_srv_nd --> someip_stack : Writable_payload
someip_stack -> someip_stack : write SOME/IP header & payload

== Publish event over LoLa shared memory ==
someip_stack -> socom_srv_nd : update_event(event, payload)
socom_srv_nd -> socom_cli_nd : on_event_update(event, payload)
socom_cli_nd -> ipc_provider : on_event_update(event, payload)
ipc_provider -> lola_shm : Send(sample)

== Receive event in gatewayd and forward to application ==
lola_shm ->> ipc_consumer : receive handler
ipc_consumer -> lola_shm : GetNewSamples()
lola_shm -> ipc_consumer : receiver(SamplePtr), per sample
ipc_consumer -> socom_srv_gd : update_event(event, payload)
socom_srv_gd -> socom_cli_gd : on_event_update(event, payload)
socom_cli_gd -> remote_svc : on_event_update(event, payload)
remote_svc -> app_mwcom : strip header, deserialize, Send(sample)
note right of ipc_consumer : The payload owns the SamplePtr.\nDropping it returns the slot.
@enduml
