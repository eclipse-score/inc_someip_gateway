@startuml component_diagram_gateway_ipc_binding_mw_com
left to right direction

interface "Gateway_ipc_binding_server" as server_api
interface "Gateway_ipc_binding_client" as client_api

package "gateway_ipc_binding_mw_com" as binding <<component>> {
  component "Server_adapter" as server
  component "Client_adapter" as client
  component "Someipd_service_provider" as sdsvc_provider
  package "Service_binding" as service_binding {
    component "Provider_service_binding" as provider
    component "Consumer_service_binding" as consumer
  }
  component "Someipd_service_consumer" as sdsvc_consumer
}

package "mw::com" as mwcom {
  component "mw::com::GenericSkeleton" as skeleton
  component "mw::com::GenericProxy" as proxy
}

package "socom" as socom {
  component "socom::Client_connector" as client_connector
  component "socom::Enabled_server_connector" as server_connector
}

server_api -- server
client_api -- client
server --> sdsvc_provider
server --> service_binding : one per Service_config
client --> service_binding : one per Service_config
client --> sdsvc_consumer
sdsvc_provider --> mwcom : offers SomeipdService
provider --> skeleton
consumer --> proxy
sdsvc_consumer --> mwcom : finds SomeipdService
provider --> client_connector
consumer --> server_connector
@enduml
