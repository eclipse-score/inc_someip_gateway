@startuml
title Event delivery for one bridged service

participant "score::socom::Server_connector\n(producer application)" as producer
participant "Provider_service_binding" as provider
participant "score::socom::Client_connector\n(provider binding)" as provider_connector
participant "GenericSkeletonEvent" as skeleton_event
participant "GenericProxyEvent" as proxy_event
participant "Consumer_service_binding" as consumer
participant "score::socom::Enabled_server_connector" as enabled_connector
participant "score::socom::Client_connector\n(consumer application)" as consumer_app

== Event update ==
producer -> provider_connector : allocate_event_payload(event_id)
provider_connector -> provider : on_event_payload_allocate(event_id)
provider -> skeleton_event : Allocate()
skeleton_event --> provider : SampleAllocateePtr<void>
note right of provider : [1] Allocation ownership
provider --> provider_connector : Writable_payload
provider_connector --> producer : Writable_payload
producer -> producer : write SOME/IP header and payload, shrink()
producer -> provider_connector : update_event(event_id, payload)
provider_connector -> provider : on_event_update(event_id, payload)
provider -> provider : write payload_length prefix,\ntake sample out of the in-flight table
provider -> skeleton_event : Send(sample)

proxy_event -> consumer : receive handler
consumer -> proxy_event : GetNewSamples(receiver, max_sample_count)
proxy_event --> consumer : SamplePtr<void>
note right of consumer : [2] Received sample ownership
consumer -> enabled_connector : update_event(event_id, payload)
enabled_connector -> consumer_app : event update
consumer_app -> consumer_app : payload destroyed, SamplePtr releases the slot
@enduml
