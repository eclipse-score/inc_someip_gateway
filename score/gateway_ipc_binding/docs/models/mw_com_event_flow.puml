@startuml mw_com_event_flow
title Bridged service: event delivery

box "providing daemon"
participant "socom::Client_connector" as client_connector
participant "Provider_service_binding" as provider
end box
participant "mw::com::GenericSkeleton" as skeleton
participant "mw::com::GenericProxy" as proxy
box "consuming daemon"
participant "Consumer_service_binding" as consumer
participant "socom::Enabled_server_connector" as server_connector
end box

== A local producer allocates and sends an event ==
client_connector -> provider : on_event_payload_allocate(event)
provider -> skeleton : Allocate()
alt a sample slot is free
  provider --> client_connector : Writable_payload over the sample
  client_connector -> provider : on_event_update(event, payload)
  provider -> skeleton : Send(sample)
  skeleton ->> proxy : new sample notification
  proxy -> consumer : receive handler
  consumer -> proxy : GetNewSamples()
  proxy -> consumer : receiver(SamplePtr), per sample
  consumer -> server_connector : update_event(event, payload)
  note right of consumer : The payload owns the SamplePtr.\nDropping it returns the slot.
else every slot is held by the peer or still in flight
  provider --> client_connector : runtime_error_sample_allocation_failed
end
@enduml
