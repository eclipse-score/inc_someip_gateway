@startuml
title gatewayd startup

box "gatewayd process"
participant "gateway_ipc_binding::mw_com::create_client" as create_client
participant "Client_adapter" as adapter
participant "Someipd_service_consumer" as someipd_consumer
participant "Someipd_service_proxy" as someipd_proxy
end box

create_client -> someipd_consumer : create(someipd_service_specifier,\nmw_com_config_json)
someipd_consumer -> someipd_proxy : StartFindService(handler, InstanceSpecifier)
someipd_consumer --> create_client : Someipd_service_consumer

opt SomeipdService is available
  someipd_proxy -> someipd_consumer : find-service handler(handles)
  someipd_consumer -> someipd_proxy : Create(handle)
  someipd_consumer -> someipd_consumer : is_connected = true
end

create_client -> create_client : make_service_bindings(runtime, services)

create_client -> adapter : construct(someipd_consumer,\nservice_bindings, identifier)
@enduml
