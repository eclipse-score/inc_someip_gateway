@startuml
title Startup of one provider-role and one consumer-role service

participant "Daemon main" as main
participant "Mw_com_binding" as binding
participant "Provider_service_binding" as provider
participant "Consumer_service_binding" as consumer
participant "mw::com" as mwcom
participant "SOCom runtime" as socom

main -> mwcom : InitializeRuntime(mw_com_config.json)
main -> binding : create_client / create_server(runtime, Service_configs)

group per Service_config with role == provider
  binding -> provider : construct
  provider -> mwcom : GenericSkeleton::Create(\n  InstanceSpecifier,\n  GenericSkeletonServiceElementInfo)
  provider -> mwcom : per event:\nSetReceiveHandlerRegistrationChangedHandler
  provider -> socom : make_client_connector(interface, instance, callbacks)
  note right of provider
    OfferService() is deferred until
    on_service_state_change(available).
  end note
end

group per Service_config with role == consumer
  binding -> consumer : construct
  consumer -> mwcom : GenericProxy::StartFindService(handler, InstanceSpecifier)
  consumer -> socom : make_server_connector(interface, instance, callbacks)
  note right of consumer
    The Disabled_server_connector is only
    enabled once the find-service handler
    reports a handle.
  end note
end

binding --> main : setup complete
note over main
  is_connected() is now true, or
  start() returned success.
end note
@enduml
