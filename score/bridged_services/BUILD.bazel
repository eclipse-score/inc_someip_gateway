"""
Bridged services on the link between gatewayd and someipd, built from the gateway configuration.
"""

load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "bridged_services",
    srcs = ["bridged_service_configs.cpp"],
    hdrs = ["bridged_service_configs.h"],
    visibility = [
        "//score/bridged_services/test:__pkg__",
        "//score/gatewayd:__pkg__",
        "//score/someipd:__pkg__",
    ],
    deps = [
        "//score/config:config_flatbuffers",
        "//score/gateway_ipc_binding:gateway_ipc_binding_mw_com",
        "//score/socom",
        "//score/someip",
    ],
)
