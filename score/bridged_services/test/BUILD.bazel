load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel/tools:json_schema_validator.bzl", "validate_json_schema_test")
load("//bazel/tools:someip_config.bzl", "generate_someip_config_bin")

generate_someip_config_bin(
    name = "bridged_services_test_config",
    json = "bridged_services_test_config.json",
    output = "bridged_services_test_config.bin",
)

validate_json_schema_test(
    name = "bridged_services_test_config_schema_valid",
    size = "small",
    json = "bridged_services_test_config.json",
    schema = "//score/config:config_schema",
    tags = ["lint"],
)

cc_test(
    name = "bridged_service_configs_test",
    size = "small",
    srcs = ["bridged_service_configs_test.cpp"],
    args = ["$(rootpath :bridged_services_test_config)"],
    data = [":bridged_services_test_config"],
    tags = ["unit"],
    deps = [
        "//score/bridged_services",
        "//score/config:config_flatbuffers",
        "//score/someip",
        "@googletest//:gtest",
    ],
)
