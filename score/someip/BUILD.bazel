"""
Common types and constants shared across the SOME/IP gateway components.
"""

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@score_docs_as_code//:docs.bzl", "docs_bundle")

cc_library(
    name = "someip",
    hdrs = [
        "constants.h",
        "types.h",
    ],
    visibility = ["//visibility:public"],
    deps = [":someip_error"],
)

cc_library(
    name = "someip_error",
    srcs = ["impl/someip_error.cpp"],
    hdrs = ["someip_error.h"],
    visibility = ["//visibility:public"],
    deps = ["@score_baselibs//score/result"],
)

# Keep the bundle at the component package boundary so coverage includes local
# implementation dependencies while excluding code owned by other components.
docs_bundle(
    name = "docs_bundle",
    code_targets = [
        ":someip",
        ":someip_error",
    ],
    primary_need_id = "comp__someip",
    source_dir = "docs",
    visibility = ["//visibility:public"],
)
