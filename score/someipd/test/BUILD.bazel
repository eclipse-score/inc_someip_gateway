load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")

py_test(
    name = "someipd_test",
    srcs = ["someipd_test.py"],
    args = [
        "$(location //score/someipd:someipd)",
        "$(location //score/config:config_file)",
    ],
    data = [
        "//score/config:config_file",
        "//score/someipd",
    ],
    tags = [
        "unit",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//quality/pytest:process",
    ],
)

cc_test(
    name = "local_network_service_test",
    size = "small",
    srcs = ["local_network_service_test.cpp"],
    tags = ["unit"],
    deps = [
        "//score/config:config_flatbuffers",
        "//score/socom",
        "//score/socom:mock",
        "//score/someipd:local_network_service",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "gatewayd_services_test",
    size = "small",
    srcs = ["gatewayd_services_test.cpp"],
    tags = [
        "block-network",
        "unit",
    ],
    deps = [
        "//score/config:config_flatbuffers",
        "//score/gateway_ipc_binding:gateway_ipc_binding_mw_com",
        "//score/socom",
        "//score/socom:mock",
        "//score/someipd:gatewayd_services",
        "//score/someipd:routing",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
